{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATLAS PINEAL",
  "version": "5.0.0",
  "identifier": "com.pineal.heretic",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../../frontend -- --host 0.0.0.0 --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build --prefix ../../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATLAS PINEAL OBSERVATORY - HERETIC v5.0 [NATIVE GPU]",
        "width": 1920,
        "height": 1080,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "useOsDefaultWindow": false,
        "contentProtected": false,
        "backgroundColor": "#000000",
        "titleBarStyle": "Visible",
        "additionalBrowserArgs": "--enable-gpu --enable-gpu-rasterization --enable-zero-copy --enable-hardware-overlays --enable-oop-rasterization --enable-accelerated-video-decode --enable-accelerated-mjpeg-decode --enable-gpu-compositing --enable-native-gpu-memory-buffers --enable-features=Vulkan,UseSkiaRenderer"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "open-external",
          "open": true
        }
      ]
    }
  }
}
