# PINEAL-HERETIC — ortam degiskenleri (bu dosyayi .env olarak kopyalayip doldurun)

# --- 9Router yerel hub (ÖNERİLEN: tüm LLM trafiği buradan geçer) ---
# 9Router, makinede çalışan OpenAI-uyumlu yerel bir yönlendiricidir
# (varsayılan uç: http://127.0.0.1:20128/v1). Tanımlıysa gateway trafiği buraya
# gider ve kanıt zincirine "provider": "9router" yazılır (yerel hub).
# UYUMLULUK: README'nin tarihsel adları PINEAL_LLM_BASE_URL / PINEAL_LLM_API_KEY
# eşdeğerdir; ikisi de kabul edilir. Hiçbiri tanımlı değilse OPENROUTER_* (bulut)
# kullanılır ve telemetri "openrouter" yazar.
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=

# --- LLM sağlayıcıları ---
# HİÇBİR anahtar zorunlu/hayati değildir. Her taşıma opsiyoneldir ve yedeklidir:
# vault (oda anahtarı) > env; hangi sağlayıcı anahtarı doluysa merdiven o kanalı
# teklif eder; OPENROUTER_API_KEY yalnız OpenRouter havuzu ÜYELİĞİDİR (santrali
# değil) — o olmasa da direct kanallar (groq/nous/google-gemini/...) ve local LLM
# çalışır. Hiçbir anahtar + local LLM yoksa LLM gerektiren ajan çağrısı durur
# (tasarım gereği; halüsinasyon önleme). Aşağıdakilerin tamamı isteğe bağlıdır.
OPENROUTER_API_KEY=

# --- Model secimi (2026-09-02 karar matrisi; env ile ezilebilir) ---
# Emekli/promo slug'lar (solar-pro4, ling-3.0-flash, glm-5.2) varsayilan DEGIL —
# yalnizca bilincli override icin kullanin. Kod: agent_core/services/llm_gateway.py
OPENROUTER_TIER_1_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TIER_2_MODEL=deepseek/deepseek-v4-flash
# 0 = sınırsız. >0 ise toplam tahmini USD bu eşiğe ulaşınca SpendCapExceeded.
# Örnek: OPENROUTER_MAX_SPEND_USD=5.00  → oturum başına max $5 harcama limiti.
# Aşılırsa SpendCapExceeded fırlatılır ve yeni LLM çağrıları reddedilir.
# [AUDIT S1] PRODUCTION'DA BU DEĞER POZİTİF OLMALIDIR: 0/tanımsız bırakılırsa
# servis ACILIŞTA REDDEDİLİR (PRODUCTION_SPEND_CAP_REQUIRED, fail-closed —
# P2-10 auth kapısıyla aynı model). 0 yalnız yerel/development içindir.
OPENROUTER_MAX_SPEND_USD=0
# OpenAI-uyumlu gateway ve tek istek timeout'u (gateway retry siniri 3'tur).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_REQUEST_TIMEOUT_SECONDS=45

# Guvenlik kapisi: 1 degilken dis LLM cagrileri kod tarafindan reddedilir.
# Canli LLM kullanmak icin: anahtar girin ve asagiyi 1 yapin.
LIVE_LLM_E2E=0

# --- Yerel LLM (opsiyonel: Ollama / LM Studio) ---
# Not: API sunucusunda Kasa (Vault) "yerel model" seçimi bu değeri ezer;
# env varsayılanı yalnız Kasa'dan use_local seçilmemişse kullanılır.
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=dolphin-llama3:latest

# --- Native LLM yönlendirici ---
# PINEAL_LLM_BACKEND=unified -> /v1/chat/completions UnifiedRouter üzerinden çalışır
#   (varsayılan). Config dosyası yoksa katalog + env anahtarlarından otomatik
#   runtime kurulur (OpenRouter her zaman; Ollama USE_LOCAL_LLM=true ise;
#   Groq/DeepSeek/Cerebras/Mistral yalnız ilgili env anahtarı doluysa).
# PINEAL_LLM_BACKEND=legacy  -> mevcut tek-sağlayıcı gateway yolu.
# DİKKAT: unified seçilip otomatik/config runtime kurulamazsa startup ÇÖKMEZ;
# fail-safe olarak legacy yola düşer ve /health "UNIFIED_ROUTER_CONFIG_MISSING"
# nedeniyle DEGRADED döner.
PINEAL_LLM_BACKEND=unified
# İsteğe bağlı dosya override: config/router.example.json. Boş bırakılırsa
# katalogdan otomatik config kullanılır. Dosyadaki credential_env ile
# işaret edilen anahtarlar (örn. OPENROUTER_API_KEY) ayrıca tanımlanmalıdır.
PINEAL_ROUTER_CONFIG=

# --- FINAL-KARAR-MATRIX: FREE-FIRST cost firewall ---
# Tier kuralları (agent_tiers.json -> _tier_route_decision; FAZ-2/FAZ-2.1 kilitli):
#   simple  : paid rota (direct veya OR-legacy) HARD DENY — yalnız free teklif edilir.
#   heavy/vision/verify: indirimli direct (ör. claude-sonnet-5@nous $1.6/$8) escalation'sız
#             izinli; liste-fiyat/frontier direct bu bayrakla (PINEAL_ALLOW_PAID_ESCALATION=1);
#             OR-legacy liste fiyatı: modelin daha ucuz indirimli direct kanalı KURULUYSA bu
#             bayrak şart; daha ucuz kanalı yoksa (yalnız-kanal) koşulsuz kalır. Kararlar
#             tier_audit_trail'e gate_context ile yazılır.
PINEAL_ALLOW_PAID_ESCALATION=0
# Fiyatı katalogda/ROUTES'ta olmayan modele çağrı yalnız açık izinle:
PINEAL_ALLOW_UNPRICED_MODELS=0
# FINAL matrix sağlayıcıları (anahtar doluysa ilgili rota kullanılabilir):
GROQ_API_KEY=            # openai/gpt-oss-120b (30 RPM / 14,400 RPD)
DEEPSEEK_API_KEY=        # deepseek-v4-* doğrudan API (agent yolunun maliyet merdiveni;
                         # fiyatlandırma ROUTES'ta tanımlı değil -> paid escalation gerekir)
# Cerebras açık free katmanı 2026-07-21'de KAPANDI (araştırma 2026-09-08):
# gpt-oss-120b@cerebras artık PAID ($0.35/$0.75) — yalnız
# PINEAL_ALLOW_PAID_ESCALATION=1 ile kullanılır; ücretsiz kanal Groq'tur.
CEREBRAS_API_KEY=        # gpt-oss-120b (5 RPM / 30K TPM / 1M TPD) — paid rota
NOUS_API_KEY=            # nous-research free/paid rotaları (policy-gated)

# --- FAZ 3: cok-saglayici havuzu (ajan yolu) ---
# Asagidaki anahtarlar DOLDURULMADIKCA havuzda gorunmez (diagnostics: no_key).
# Anahtar + model eslesmesi + policy kapisi (paid -> PINEAL_ALLOW_PAID_ESCALATION=1)
# birlikte saglanmadan trafik yayilmaz; sessiz harcama uretilmez.
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DASHSCOPE_API_KEY=        # alibaba-dashscope (OpenAI-uyumlu endpoint)
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=           # nvidia-nim (nvapi-... anahtarlari; standart ad)
HUGGINGFACE_API_KEY=
DEEPINFRA_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=           # google-gemini — Google'in RESMI OpenAI-uyumlu
                          # endpoint'i (.../v1beta/openai/); sifir ek transport
                          # koduyla ajan merdiveninde (canli dogrulama ayri is)
# Katalogda `models` bos olan saglayiciya operator beyaniyla model acilir
# (ornek: PINEAL_PROVIDER_MODELS_TOGETHER="acme/m7"). Beyan, firewall/cap/
# kota kapilarini ATLAMAZ; uydurma katalog girdisi yazilmaz.
#PINEAL_PROVIDER_MODELS_MISTRAL=
#PINEAL_PROVIDER_MODELS_TOGETHER=
#PINEAL_PROVIDER_MODELS_FIREWORKS=
#PINEAL_PROVIDER_MODELS_ALIBABA_DASHSCOPE=
#PINEAL_PROVIDER_MODELS_GOOGLE_GEMINI=   # ornek: "gemini-2.5-flash" (operator beyanidir, katalog iddiasi degil)
#PINEAL_PROVIDER_MODELS_NVIDIA_NIM=      # ornek: "nvidia/llama-3.1-nemotron-70b-instruct" (canli /models listesinden)
#PINEAL_PROVIDER_MODELS_DEEPSEEK=        # ornek: "deepseek-chat"
# NOT: OPENAI/ANTHROPIC/XAI/COHERE/AZURE anahtarlari tasiyici (transport)
# openai_chat olmadigi icin havuza giremez; route_diagnostics'te
# transport_unsupported olarak GORUNUR (sessiz yutma yok).
IFLOW_API_KEY=            # tasiyici bilinmiyor -> tani-only (baz URL gerekli, bkz. asagi)
# FAZ-2-P4 (2026-09-08): GEMINI_BACKUP_API_KEY artik DIRECT — ayni Google
# endpoint'inin 2. anahtari; birincil 429/limit verince merdiven otomatik
# backup'a duser (google-gemini-backup, ROUTES paid $0.75/$3.75).
GEMINI_BACKUP_API_KEY=
GEMINI_VERTEX_TOKEN=      # vertex farkli base/protokol ister -> tani-only (canli dogrulama sonrasi)

# --- Arama (AutonomousVerifier; Tavily / SerpAPI / Exa) ---
TAVILY_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=

# --- Guvenlik (FAZ 8) ---
# [AUDIT P2-10] Varsayilan artik FAIL-CLOSED: PINEAL_ENV yalnizca asagidaki
# ACIK degerlerden biriyse gelistirme sayilir ->
#   development | dev | local | localhost | test | testing | ci
# Bos, yazim-hatali veya taninmayan HER deger (production, prod, staging...)
# URETIM kabul edilir ve PINEAL_TOKEN ZORUNLU olur; token yoksa servis
# startup'ta PRODUCTION_AUTH_REQUIRED ile durur. Eskiden PINEAL_ENV
# unutulunca tum /api/* ve /v1/* kimlik dogrulamasiz aciliyordu.
# development: token bos olabilir; /health bunu DISABLED_DEVELOPMENT_ONLY diye bildirir.
# production: token ZORUNLUDUR, yoksa servis startup'ta fail-closed durur.
# [AUDIT R2] Bu satir AMACILI YORUMLU: .env icinde AKTIF PINEAL_ENV yoksa
# docker compose imaj/`environment` default'ini (production) devralir ->
# fail-closed. Eskiden buradaki aktif `PINEAL_ENV=development` satiri
# compose env_file'i uzerinden imaj ENV'ini EZIYOR, konteyner sessizce
# development modunda (auth kapali) aciliyordu.
#   - baslat.bat (yerel): PINEAL_ENV yoksa otomatik development koyar.
#   - docker compose (yerel gelistirme): bilerek development istiyorsaniz
#     .env'e siz PINEAL_ENV=development yazin (acik secim).
#   - docker compose (uretim): bos birakinin -> production + PINEAL_TOKEN zorunlu.
#PINEAL_ENV=development
PINEAL_REQUIRE_AUTH=false
# Tanimlanirsa tum /api/* X-API-Key ister. WS anahtari URL'ye degil ilk mesaja yazilir.
PINEAL_TOKEN=
# [AUDIT N7] Hiz siniri KIMLIGI: token sunulan istekte = token; token'siz
# istekte (yalniz development modunda mumkun) = istemci IP. Reverse proxy
# arkasinda (tum trafik tek IP) token'siz kullanicilar AYNI rate kovasini
# paylasir ve birbirini bloklayabilir (orn. initiate 5/dk paylasilir).
# Production'da istemciler token kullandigi icin bu etkilenmez.
# [AUDIT 2026-09-11 P0] VITE_PINEAL_TOKEN KALDIRILDI: server secret'i frontend
# bundle'ina gomulmez (Vite VITE_* degerlerini plaintext derler -> token sizardi).
# UI, PINEAL_TOKEN'i YALNIZ calisma zamaninda Kasa panelinden alir (localStorage).
# Disaridan erisime izin verilecek originler (virgulle, bos ise localhost kumesi)
PINEAL_ALLOWED_ORIGINS=
# --- Kaynak tavani (AUDIT P0-2 / P0-4 / P0-5) ---
# client_id istemcinin sectigi bir string oldugu icin bu tavanlar olmadan tek
# bir istemci sinirsiz oda (her biri tam bir executor) ve sinirsiz hiz-siniri
# kovasi uretebilirdi. Asagidaki degerler olculen sizintiyi sinirlar.
PINEAL_MAX_ROOMS=512
PINEAL_ROOM_TTL_SECONDS=1800
PINEAL_MAX_CLIENT_ID_LENGTH=64
PINEAL_MAX_RATE_BUCKETS=100000
# [AUDIT P0-5 v3] Süresi dolmuş hız-kovası girdileri YALNIZCA tavanda değil,
# bu aralık doldukça da geri kazanılır (varsayılan 60 sn). Süpürme, tavan
# aşıldığında her istekte değil tavanın ~%80'ine inerek çalışır (histerezis);
# aksi halde dolu bir tabloda istek başına ~57 ms ölçülmüştü.
PINEAL_RATE_SWEEP_INTERVAL_SECONDS=60
# Yanit onbellegi satir tavani (TTL'den bagimsiz ikinci emniyet kemeri)
PINEAL_CACHE_MAX_ROWS=50000

# --- Vision (FAZ 3) ---
# Gorselli isteklerde kullanilacak OpenRouter modeli
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash

# --- Cache / Hafiza (opsiyonel) ---
# LLM yanit onbellegi (1=acik, 0=kapali); varsayilan acik
PINEAL_RESPONSE_CACHE=1
# Bellek motoru: canonical (varsayilan) | hindsight (anlamsal arama, sentence-transformers gerekir)
PINEAL_MEMORY_ENGINE=canonical

# --- OSINT entegrasyonlari (FAZ 1-5; hepsi DENEYSEL, default KAPALI) ---
# Her kapisi acmak yeni ag cagrilari acar; kapaliyken pipeline davranisi degismez.
ENABLE_MAIGRET=false            # kullanici-adi varlik taramasi (POST /api/experimental/maigret/scan)
MAIGRET_SITES_LIMIT=100         # 1..500
MAIGRET_TIMEOUT=15              # s/site (max 60)
MAIGRET_TOTAL_TIMEOUT=45        # s (max 180)
ENABLE_HOLEHE=false             # e-posta kayit taramasi (POST /api/experimental/holehe/scan)
HOLEHE_MODULES_LIMIT=100        # 1..300 (deterministik isim-sirali ilk N)
HOLEHE_TIMEOUT=10               # s (max 60)
HOLEHE_TOTAL_TIMEOUT=120        # s (max 600)
HOLEHE_CONCURRENCY=20           # eszamanli modul (max 50)
ENABLE_CRAWL4AI=false           # sayfa -> LLM-dostu metin (POST /api/experimental/crawl/fetch)
CRAWL4AI_RENDERER=http          # http (binary gerektirmez) | browser (Playwright; binary yoksa browser_missing)
CRAWL4AI_MAX_CHARS=8000         # metin kirpma (max 50000)
CRAWL4AI_TIMEOUT=20             # s (max 120)
CRAWL4AI_RESEARCH_LIMIT=2       # public-web arastirmada kac sonuca crawl (max 5)
# Kurulum notu: crawl4ai psutil>=6.1.1, open-interpreter psutil<6.0.0 BEYAN eder;
# ikinci adim dosyasiyla kurulur:
#   pip install -r requirements.txt && pip install -r requirements-osint.txt

# --- FAZ A · RETINA yetenek kapilari (hepsi default KAPALI) ---
# Kapaliyetenek: available=false + makine-okunur sebep; sistemin geri kalani
# birebir ayni calisir (uydurma veri yok). Kutuphaneler Ucuncu adim dosyasi:
#   pip install -r requirements-retina.txt   (ISTEGE BAGLI)
ENABLE_SCRAPLING=false          # 3. kademe adaptif kazima (site degisse de kirilmaz)
ENABLE_X_SENSOR=false           # X/Twitter gercek sensoru (twscrape; operatörün kendi hesabi)
ENABLE_IG_SECONDARY=false       # Instagram IKINCI kaynak (instagrapi; birincil Playwright)
IG_USERNAME=                    # ENABLE_IG_SECONDARY icin
IG_PASSWORD=                    # ENABLE_IG_SECONDARY icin (log/kanit/telemetriye yazilmaz)
ENABLE_AGENT_REACH=false        # harici CLI: agent-reach read (X/Reddit/YouTube/GitHub)
ENABLE_SEARXNG=false            # anahtarsiz metasearch (AYRI SERVIS, AGPL-3.0)
SEARXNG_BASE_URL=               # ornek: http://127.0.0.1:8080 (kod gomulmez, yalniz HTTP)

# --- FAZ C · SES & NEFES (C2 yerel TTS; ses MAKINEDEN CIKMAZ) ---
# Motor iki yoldan biriyle bulunur; ikisi de YERELDIR:
#   1) piper CLI  -> PINEAL_PIPER_MODEL dolu olmali (piper PATH'te)
#   2) yerel TTS ucu -> PINEAL_TTS_URL (VoxCPM / MOSS-TTS / her yerel sunucu).
#      Yalniz 127.0.0.1 / localhost / [::1] kabul edilir; UZAK uc reddedilir.
# Motor yoksa ses UYDURULMAZ: /api/speech/say -> available:false + sebep.
ENABLE_LOCAL_TTS=false          # ses kapisi (kapaliyken hicbir motor cagrilmaz)
PINEAL_PIPER_MODEL=             # ornek: /opt/piper/tr-TR-fahrettin-medium.onnx
PINEAL_TTS_URL=                 # ornek: http://127.0.0.1:8000/tts (YEREL olmak zorunda)
PINEAL_TTS_VOICE=               # motorun konus/mac birimi (bos = motor varsayilani)
PINEAL_SPEECH_DIR=              # bos = memory/speech (uretilen ses dosyalari)

# --- Stealth saglayici secici (FAZ 5; kapı degil secim) ---
# playwright_stealth (default, bugunku davranis) | invisible | cloak | none
STEALTH_PROVIDER=playwright_stealth
# invisible/cloak binary INDIRMEZ; operator gosterirse available olur:
INVISIBLE_BROWSER_BINARY=       # patched Firefox yolu (opsiyonel)
CLOAK_BROWSER_EXECUTABLE=       # CloakBrowser Chromium yolu (opsiyonel)
# Kokpit LCD canlı tarayıcısı: playwright chromium indirmeden sistem
# Chromium'unu kullanır (örn. /usr/bin/chromium). Boşsa playwright binary'si.
PINEAL_CHROMIUM_PATH=

# --- Diger kullanilan ama orneklenmemis degiskenler ---
OSINT_INDUSTRIES_KEY=           # doluysa osint_investigator gercek API'yi kullanir; bossa durust fallback
ENABLE_INTERPRETER=false        # interpreter ajanini etkinlestirir
ALLOW_LOCAL_TO_CLOUD_FALLBACK=  # bos bos; yerel-LLM yoksa buluta dusme izni (false: dusmez)
SERPAPI_KEY=                    # arama saglayici (SERPAPI_API_KEY'a alternatif okuma adi)

# --- Instagram kaziyici: guven + zamansal zenginlestirme (FAZ 1) ---
PINEAL_MIN_SCRAPER_CONFIDENCE=0.6  # 0.0..1.0; altinda HALT (anti-halusinasyon kapisi)
PINEAL_POST_DETAIL_ENABLED=true    # tekil post sayfalarindan caption/tarih/etkilesim tamamla
PINEAL_POST_DETAIL_LIMIT=12        # 0..12; 0 = grid-verisiyle yetin (eski davranis)

# --- Docker build (build-time; runtime'i etkilemez) ---
# Chromium indirmesi (cdn.playwright.dev) bolgenizde engelliyse/yavamsa ayna.
# Dockerfile 3 kez dener + 300 sn baglanti t/o kullanir; bu degisken ek ayna saglar.
# Ornek: PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
PLAYWRIGHT_DOWNLOAD_HOST=
